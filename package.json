{
  "name": "weir-research",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup:pdf": "node scripts/setup-docling.mjs",
    "test:pdf": "node scripts/test-docling.mjs",
    "start": "node scripts/start.mjs",
    "serve": "node server/main.mjs",
    "research": "node scripts/research.mjs",
    "example": "npm run build && node scripts/example.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run test && npm run build",
    "lavish": "npm run build && lavish-axi dist/index.html",
    "open:brave": "npm run build && open -a 'Brave Browser' dist/index.html",
    "workspace": "node scripts/workspace.mjs",
    "coordinator": "node scripts/coordinator.mjs",
    "context:review": "node --no-warnings scripts/context-review.mjs",
    "context:eval": "node --no-warnings scripts/context-eval.mjs",
    "test:integration": "npm run build && node scripts/test-coordinator.mjs && node scripts/test-project-start.mjs && node scripts/test-findings.mjs && node --no-warnings scripts/test-isolation.mjs && node --no-warnings scripts/test-research-browser.mjs",
    "convert:batches": "node --no-warnings scripts/convert-to-batches.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@napi-rs/canvas": "^1.0.9",
    "@tesseract.js-data/eng": "^1.0.0",
    "d3": "^7.9.0",
    "pdfjs-dist": "^6.3.289",
    "puppeteer-core": "^25.12.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^24.0.0",
    "chrome-devtools-mcp": "1.6.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-singlefile": "^2.2.0",
    "vitest": "^3.2.4"
  }
}
